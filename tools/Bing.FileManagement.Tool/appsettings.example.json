{
  "ConnectionStrings": { "FileManagement": "Data Source=H:/temp/Bing.FileManagement.Demo.Local/files.db" },
  "FileManagement": {
    "Orm": "EFCore",
    "Database": "Sqlite",
    "MySqlVersion": "8.0.36",
    "DefaultStore": "local-v1",
    "Stores": {
      "local-v1": { "Provider": "FileSystem", "RootPath": "H:/temp/Bing.FileManagement.Demo.Local/objects" },
      "minio-v1": { "Provider": "Minio", "Endpoint": "http://127.0.0.1:19000", "StorageNamespace": "file-demo" },
      "qiniu-east-v1": {
        "Provider": "Qiniu",
        "Endpoint": "https://s3.cn-east-1.qiniucs.com",
        "Region": "cn-east-1",
        "AccessKey": "replace-through-environment-variable",
        "SecretKey": "replace-through-environment-variable",
        "StorageNamespace": "file-management",
        "ForcePathStyle": true,
        "ListPartsPageSize": 1000,
        "UploadMode": "ServerProxy",
        "ContainerBuckets": {
          "attachments": "replace-with-actual-s3-space-name",
          "public": "replace-with-actual-s3-space-name"
        }
      }
    }
  }
}
