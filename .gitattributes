# ============================================================
# Git Attributes
#
# 仓库统一：
# - 文本文件使用 LF
# - 禁止 Git 根据 Windows/Linux 自动切换 CRLF/LF
# - 二进制文件不进行文本转换
# ============================================================


# ============================================================
# 默认文本规则
# ============================================================

# 自动识别文本文件，并强制 checkout / index 使用 LF
* text=auto eol=lf

# ============================================================
# .NET / C#
# ============================================================
*.cs          text eol=lf
*.csx         text eol=lf
*.vb          text eol=lf
*.fs          text eol=lf
*.fsi         text eol=lf
*.fsx         text eol=lf

*.csproj      text eol=lf
*.fsproj      text eol=lf
*.vbproj      text eol=lf

*.sln         text eol=lf
*.slnx        text eol=lf

*.props       text eol=lf
*.targets     text eol=lf
*.tasks       text eol=lf
*.proj        text eol=lf
*.projitems   text eol=lf

*.ruleset     text eol=lf
*.editorconfig text eol=lf

*.resx        text eol=lf
*.config      text eol=lf
*.nuspec      text eol=lf

# ============================================================
# NuGet / .NET Tooling
# ============================================================
NuGet.Config           text eol=lf
nuget.config           text eol=lf

global.json            text eol=lf

Directory.Build.props  text eol=lf
Directory.Build.targets text eol=lf
Directory.Packages.props text eol=lf

