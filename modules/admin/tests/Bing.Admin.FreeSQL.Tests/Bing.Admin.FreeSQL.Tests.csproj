  <Target Name="CopyInventoryProbeToTestOutput" AfterTargets="Build">
    <MSBuild Projects="..\Bing.Admin.FreeSQL.InventoryProbe\Bing.Admin.FreeSQL.InventoryProbe.csproj"
             Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="_InventoryProbeTargetPath" />
    </MSBuild>
    <ItemGroup>
      <_InventoryProbeOutput Include="%(_InventoryProbeTargetPath.RootDir)%(_InventoryProbeTargetPath.Directory)**\*" />
    </ItemGroup>
    <Error Condition="'@(_InventoryProbeOutput)' == ''"
           Text="Bing.Admin.FreeSQL.InventoryProbe produced no files for $(Configuration)/net6.0." />
    <Copy SourceFiles="@(_InventoryProbeOutput)"
          DestinationFiles="@(_InventoryProbeOutput->'$(OutDir)InventoryProbe\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
</Project>
