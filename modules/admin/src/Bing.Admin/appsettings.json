{
  "ConnectionStrings": {
    "DefaultConnection": "",
    "RedisConnection": ""
  },
  "Caching": {
    "Namespace": "bing.admin.sample"
  },
  "JwtOptions": {
    "Issuer": "bing.admin",
    "Audience": "bing.admin",
    "Secret": "",
    "AccessExpireMinutes": 50,
    "RefreshExpireMinutes": 60,
    "ThrowEnabled": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft": "Warning",
      "DotNetCore.CAP": "Warning",
      "Bing": "Trace"
    },
    "Console": {
      "TimestampFormat": "[yyyy-MM-dd HH:mm:ss:fff] ",
      "LogLevel": {
        "Default": "Debug",
        "Microsoft": "Warning"
      }
    }
  },
  "Exceptionless": {
    "ApiKey": "",
    "ServerUrl": ""
  },
  "Serilog": {
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "d:\\bing.admin\\log.txt",
          "rollingInterval": "Day",
          "rollOnFileSizeLimit": true,
          "fileSizeLimitBytes": 102400,
          "retainedFileCountLimit": 10,
          "outputTemplate": "{LogLevel}: {TraceId}  >>  [{SourceContext}] [{Timestamp:yyyy-MM-dd HH:mm:ss.fff}] [{Duration}]{NewLine}{Message}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
