# ------------------------------------------------------------
# 当前项目专用的 Universal Agent Workflow / 飞书通知配置
# 复制为：.agents/.env.local
# .env.local 不要提交 Git
# ------------------------------------------------------------

# 是否启用飞书通知
FEISHU_ENABLED=true

# 当前项目对应的飞书群自定义机器人 Webhook
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxxxxxxxxxx

# 如果飞书机器人开启“签名校验”，填写签名密钥；未开启则留空
FEISHU_SECRET=

# 飞书消息里显示的项目名；不填时默认使用 Workspace 目录名
FEISHU_PROJECT_NAME=fund-eye-client

# 建议改成当前项目名称
FEISHU_MESSAGE_PREFIX=AI Workflow · FundEye

# HTTP 超时，毫秒
FEISHU_TIMEOUT_MS=10000

# 飞书通知格式：
# card = Card JSON 2.0（推荐）
# text = 纯文本回退
FEISHU_MESSAGE_MODE=card

# ------------------------------------------------------------
# 通用任务状态
# ------------------------------------------------------------

# 当前 execute-plan / fix-review 运行状态文件
AI_TASK_STATE_FILE=.agents/runtime/current-task.json

# 可选：自定义项目级 env 文件位置
# AI_WORKFLOW_ENV_FILE=.agents/.env.local

# ------------------------------------------------------------
# Antigravity Stop Guard（仅 Antigravity IDE 使用）
# ------------------------------------------------------------

# model_stop 且任务尚未形成终态时，是否要求 Agent 继续
STOP_GUARD_ENABLED=true

# 最大自动续跑次数，防止无限循环；0 表示不自动续跑
STOP_GUARD_MAX_CONTINUES=3

# 是否允许 Universal Workflow 发送阶段/任务通知
# 优先级高于旧的 STOP_GUARD_NOTIFY
AI_WORKFLOW_NOTIFY=true

# 兼容旧配置；建议新项目使用 AI_WORKFLOW_NOTIFY
STOP_GUARD_NOTIFY=true

# ------------------------------------------------------------
# Copilot Hook
# ------------------------------------------------------------

# 是否启用 Copilot Workspace Hook 的阶段检测/通知兜底
AI_WORKFLOW_COPILOT_HOOK=true

# Copilot Stop Hook 在任务仍 IN_PROGRESS 时是否允许阻止一次 Stop
AI_WORKFLOW_COPILOT_STOP_GUARD=true
