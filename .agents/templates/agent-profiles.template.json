{
  "version": 3,
  "displayName": "Universal Agent 角色运行时配置",
  "description": "统一管理 Copilot、Codex、Antigravity 在 Planner / Executor / Reviewer / Fixer 角色下使用的模型、思考等级和执行模式。",
  "defaultProfile": "balanced",
  "notes": {
    "copilotModel": "请填写 VS Code Copilot 模型选择器中实际显示的模型名称，或当前项目已注册的自定义模型名称。",
    "codexModel": "请填写当前 Codex 安装环境中实际可用的 OpenAI/Codex 模型标识。",
    "antigravityModel": "请填写当前 Antigravity 安装环境中可用的 Custom Agent 模型名称或别名。",
    "effort": "不同 Harness 对思考等级的应用方式不同：Codex 可按角色原生配置；Copilot IDE 主要按模型/会话记忆；Antigravity 当前按会话或安装版本支持能力应用。",
    "sourceOfTruth": "本文件是角色模型、思考等级与执行模式策略的唯一人工维护源。下游配置通过 sync-agent-profiles.mjs 同步。",
    "executionMode": "executionMode 描述角色的执行方式。Codex 与 Antigravity 可使用 goal；Copilot IDE 使用 agent。Goal 负责长目标推理与持续执行，Skill 仍负责阶段职责和边界。",
    "goal": "Goal 不替代 Skill：create-plan / execute-plan / review-code / fix-review 定义做什么，Goal 定义持续推理和执行到阶段完成的自主性。"
  },
  "capabilities": {
    "copilot": {
      "agentModel": "native",
      "agentEffort": "remembered",
      "goalMode": "agent"
    },
    "codex": {
      "agentModel": "native",
      "agentEffort": "native",
      "goalMode": "native"
    },
    "antigravity": {
      "agentModel": "native",
      "agentEffort": "session",
      "goalMode": "native"
    }
  },
  "workflowRoles": {
    "create-plan": "plan-writer",
    "execute-plan": "plan-executor",
    "review-code": "code-reviewer",
    "review-plan": "code-reviewer",
    "fix-review": "review-fixer"
  },
  "profiles": {
    "fast": {
      "displayName": "快速模式",
      "description": "优先响应速度和模型使用成本，适合简单改动、常规维护和低风险任务。",
      "notes": "不建议用于复杂架构设计、跨模块重构、关键数据迁移或高风险代码审查。",
      "roles": {
        "plan-writer": {
          "displayName": "计划规划器",
          "description": "负责读取需求、项目规则和真实源码，生成可执行的 plan.md。",
          "notes": "只负责规划，不直接修改业务代码、测试、配置或数据库。",
          "copilot": {
            "model": "GPT-5.6 Luna",
            "effort": "low",
            "executionMode": "agent"
          },
          "codex": {
            "model": "gpt-5.6-luna",
            "effort": "low",
            "executionMode": "goal"
          },
          "antigravity": {
            "model": "flash",
            "effort": "low",
            "executionMode": "interactive"
          }
        },
        "plan-executor": {
          "displayName": "计划执行器",
          "description": "负责按照已批准的 plan.md 完成真实代码实现、测试、验证和 execution.md。",
          "notes": "不重新规划整体方案，不自动 git commit、git push 或创建 PR。",
          "copilot": {
            "model": "GPT-5.6 Terra",
            "effort": "medium",
            "executionMode": "agent"
          },
          "codex": {
            "model": "gpt-5.6-terra",
            "effort": "medium",
            "executionMode": "goal"
          },
          "antigravity": {
            "model": "flash",
            "effort": "medium",
            "executionMode": "goal"
          }
        },
        "code-reviewer": {
          "displayName": "代码审查器",
          "description": "负责独立检查 plan.md 的真实实施结果、Git Diff、测试和运行证据，生成 review.md。",
          "notes": "只审查，不直接修改业务代码；未解决 MUST_FIX/SHOULD_FIX 时保持 NEEDS_FIX。",
          "copilot": {
            "model": "GPT-5.6 Terra",
            "effort": "medium",
            "executionMode": "agent"
          },
          "codex": {
            "model": "gpt-5.6-terra",
