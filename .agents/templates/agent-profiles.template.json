          "notes": "默认 fixScope=recommended，处理 MUST_FIX + SHOULD_FIX；OPTIONAL 默认不自动处理。",
          "copilot": {
            "model": "GPT-5.6 Luna",
            "effort": "medium",
            "executionMode": "agent"
          },
          "codex": {
            "model": "gpt-5.6-luna",
