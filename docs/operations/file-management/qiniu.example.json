{
  "FileManagement": {
    "DefaultStore": "qiniu-east-v1",
    "Stores": {
      "qiniu-east-v1": {
        "Provider": "Qiniu",
        "Endpoint": "https://s3.<region>.qiniucs.com",
        "Region": "<region>",
        "AccessKey": "replace-through-secret-injection",
        "SecretKey": "replace-through-secret-injection",
        "StorageNamespace": "file-management",
        "ForcePathStyle": true,
        "ListPartsPageSize": 1000,
        "UploadMode": "ServerProxy",
        "ContainerBuckets": {
          "attachments": "replace-with-actual-s3-space-name",
          "public": "replace-with-actual-s3-space-name"
        }
      }
    }
  }
}
