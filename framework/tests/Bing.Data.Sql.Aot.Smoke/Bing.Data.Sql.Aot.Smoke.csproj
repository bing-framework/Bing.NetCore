<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishAot Condition="'$(PublishAot)' == ''">true</PublishAot>
    <BingSqlAotStrict>true</BingSqlAotStrict>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>obj/generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>
  <Import Project="../../src/Bing.Data.Sql.Generators/buildTransitive/Bing.Data.Sql.Generators.props" Condition="'$(BingSqlGenerationEnabled)' != 'false' and '$(BingSqlGeneratorPackageVersion)' == ''" />
  <ItemGroup>
    <ProjectReference Include="../../src/Bing.Dapper.Sqlite/Bing.Dapper.Sqlite.csproj" />
    <ProjectReference Include="../../src/Bing.Data.Sql.Generators/Bing.Data.Sql.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" Condition="'$(BingSqlGenerationEnabled)' != 'false' and '$(BingSqlGeneratorPackageVersion)' == ''" />
    <PackageReference Include="Bing.Data.Sql.Generators" Version="$(BingSqlGeneratorPackageVersion)" PrivateAssets="all" Condition="'$(BingSqlGeneratorPackageVersion)' != ''" />
  </ItemGroup>
</Project>
