<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\..\framework.tests.props" />
  <PropertyGroup>
    <RootNamespace>Bing.Dapper.Tests</RootNamespace>
    <XunitStartupFullName>Bing.Dapper.Tests.Startup</XunitStartupFullName>
    <TestTfmsInParallel>false</TestTfmsInParallel>
  </PropertyGroup>

  <PropertyGroup>
    <BingTestingUseXunitDependencyInjection>true</BingTestingUseXunitDependencyInjection>
    <BingTestingUseDependencyInjectionLogging>true</BingTestingUseDependencyInjectionLogging>
    <BingTestingUseAspectCore>true</BingTestingUseAspectCore>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Bing.Dapper.PostgreSql\Bing.Dapper.PostgreSql.csproj" />
    <ProjectReference Include="..\Bing.Test.Shared\Bing.Test.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="appsettings.*.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <DependentUpon>appsettings.json</DependentUpon>
    </Content>
  </ItemGroup>

  <!-- 运行时环境变量 -->
  <PropertyGroup>
    <RunSettingsFilePath>$(MSBuildProjectDirectory)\integration.runsettings</RunSettingsFilePath>
  </PropertyGroup>

</Project>
