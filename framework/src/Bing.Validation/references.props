<Project>
  <ItemGroup>
    <!-- ValidAttribute 位于 Bing.Validation.Abstractions，此处不依赖 AOP 执行器 -->
    <!-- 直接引用 Bing.Core（之前由 Bing.Aop.AspectCore 传递），用于 BingException 等基础类型 -->
    <ProjectReference Include="..\Bing.Core\Bing.Core.csproj" />
    <ProjectReference Include="..\Bing.Validation.Abstractions\Bing.Validation.Abstractions.csproj" />
  </ItemGroup>
</Project>
