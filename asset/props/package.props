<Project>
  <PropertyGroup Label="Package">
    <Authors>简玄冰</Authors>
    <Company>简玄冰</Company>
    <Copyright>简玄冰</Copyright>
    <RepositoryUrl>https://github.com/bing-framework/Bing.NetCore</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/bing-framework/Bing.NetCore</PackageProjectUrl>
    <PackageIcon>icon.png</PackageIcon>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageTags>bing;applicationframework;dotnetcore;aspnetcore;</PackageTags>
    <PackageReleaseNotes>Bing应用框架以MIT开源发布，可随意使用</PackageReleaseNotes>
  </PropertyGroup>

  <PropertyGroup>
    <!--创建符号包-->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!--包内嵌 README：工程目录下存在 README.md 时才声明，避免 NU5039。
      新增工程请一并创建 README.md（模板参考 framework/src/Bing.Core/README.md）-->
  <PropertyGroup Condition="Exists('$(MSBuildProjectDirectory)/README.md')">
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)/README.md')">
    <None Include="$(MSBuildProjectDirectory)/README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!--注意：包图标 icon.png 的打包声明在 asset/props/misc.props 中（PackageIcon 在本文上方声明）。
      两处必须配套存在，否则 pack 会报 NU5046（找不到图标文件）。-->
</Project>