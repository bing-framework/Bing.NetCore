<Project>

  <!--
    ============================================================================
    Bing Testing - Compatibility Matrix
    ============================================================================
    负责：
    - 不同 TFM 的 Test SDK / Runner / Coverlet / Moq / Shouldly 版本；
    - xUnit v3 支持范围；
    - xUnit V2 / V3 / Auto 模式解析；
    - 对调用方提供 Override 能力。

    设计原则：
    - 默认采用 Modern Profile；
    - 只对旧框架进行兼容性降级；
    - 不把所有未来 TFM 都硬编码成独立版本表；
    - xUnit v2 / v3 为双栈设计。
    ============================================================================
  -->

  <!-- =========================================================
       默认配置：Modern Profile
       
       主要面向：
       - net472 / net48 / net481
       - net8.0+
       - 后续新的现代 .NET
       ========================================================= -->
  <PropertyGroup>
    <BingTestingProfile Condition="'$(BingTestingProfile)' == ''">Modern</BingTestingProfile>
    <BingTestingRunnable Condition="'$(BingTestingRunnable)' == ''">true</BingTestingRunnable>
    <BingTestingCoverageSupported Condition="'$(BingTestingCoverageSupported)' == ''">true</BingTestingCoverageSupported>
    <BingTestingXunitV3Supported Condition="'$(BingTestingXunitV3Supported)' == ''">false</BingTestingXunitV3Supported>

    <!-- xUnit Framework -->
    <BingXunitV2Version Condition="'$(BingXunitV2Version)' == ''">2.9.3</BingXunitV2Version>
    <BingXunitV3Version Condition="'$(BingXunitV3Version)' == ''">4.0.0</BingXunitV3Version>

    <!-- Modern Test Infrastructure -->
    <BingMicrosoftNetTestSdkVersion Condition="'$(BingMicrosoftNetTestSdkVersion)' == ''">18.9.0</BingMicrosoftNetTestSdkVersion>
    <BingXunitRunnerVersion Condition="'$(BingXunitRunnerVersion)' == ''">4.0.0</BingXunitRunnerVersion>
    <BingCoverletVersion Condition="'$(BingCoverletVersion)' == ''">10.0.1</BingCoverletVersion>

    <!-- Assertion / Mock -->
    <BingShouldlyVersion Condition="'$(BingShouldlyVersion)' == ''">4.3.0</BingShouldlyVersion>
    <BingMoqVersion Condition="'$(BingMoqVersion)' == ''">4.20.72</BingMoqVersion>

  </PropertyGroup>

  <!-- =========================================================
       netstandard：不是测试运行时

       netstandard 只能作为 API/Library Target，
       不应作为真正的 test runtime。
       ========================================================= -->
  <PropertyGroup Condition="
      '$(TargetFramework)' == 'netstandard1.3'
      Or '$(TargetFramework)' == 'netstandard1.6'
      Or '$(TargetFramework)' == 'netstandard2.0'
      Or '$(TargetFramework)' == 'netstandard2.1'">
    <BingTestingProfile>NetStandard</BingTestingProfile>
    <BingTestingRunnable>false</BingTestingRunnable>
    <BingTestingCoverageSupported>false</BingTestingCoverageSupported>
    <BingTestingXunitV3Supported>false</BingTestingXunitV3Supported>
  </PropertyGroup>

  <!-- =========================================================
       Legacy Profile

       .NET Framework:
       net45 / net451 / net452 / net46 / net461

       .NET Core:
       netcoreapp2.1 / netcoreapp2.2 / netcoreapp3.0
       ========================================================= -->
  <PropertyGroup Condition="
      '$(TargetFramework)' == 'net45'
      Or '$(TargetFramework)' == 'net451'
      Or '$(TargetFramework)' == 'net452'
      Or '$(TargetFramework)' == 'net46'
      Or '$(TargetFramework)' == 'net461'
      Or '$(TargetFramework)' == 'netcoreapp2.1'
      Or '$(TargetFramework)' == 'netcoreapp2.2'
      Or '$(TargetFramework)' == 'netcoreapp3.0'">
    <BingTestingProfile>Legacy</BingTestingProfile>
    <BingMicrosoftNetTestSdkVersion>16.11.0</BingMicrosoftNetTestSdkVersion>
    <BingXunitRunnerVersion>2.4.3</BingXunitRunnerVersion>
    <BingShouldlyVersion>3.0.2</BingShouldlyVersion>
    <BingMoqVersion>4.16.1</BingMoqVersion>
    <BingTestingCoverageSupported>false</BingTestingCoverageSupported>
    <BingTestingXunitV3Supported>false</BingTestingXunitV3Supported>
  </PropertyGroup>


  <!-- =========================================================
       Transitional Profile
       
       .NET Framework:
       net462 / net47 / net471

       .NET:
       netcoreapp3.1 / net5.0
       ========================================================= -->
  <PropertyGroup Condition="
      '$(TargetFramework)' == 'net462'
      Or '$(TargetFramework)' == 'net47'
      Or '$(TargetFramework)' == 'net471'
      Or '$(TargetFramework)' == 'netcoreapp3.1'
      Or '$(TargetFramework)' == 'net5.0'">
    <BingTestingProfile>Transitional</BingTestingProfile>
    <BingMicrosoftNetTestSdkVersion>17.13.0</BingMicrosoftNetTestSdkVersion>
    <BingXunitRunnerVersion>2.4.5</BingXunitRunnerVersion>
    <BingCoverletVersion>6.0.4</BingCoverletVersion>
    <BingTestingXunitV3Supported>false</BingTestingXunitV3Supported>
  </PropertyGroup>

  <!-- netcoreapp3.1 / net5.0 默认不启用当前 Coverlet Collector -->
  <PropertyGroup Condition="
      '$(TargetFramework)' == 'netcoreapp3.1'
      Or '$(TargetFramework)' == 'net5.0'">
    <BingTestingCoverageSupported>false</BingTestingCoverageSupported>
  </PropertyGroup>

  <!-- =========================================================
       .NET 6 / .NET 7

       xunit.runner.visualstudio 2.8.2：
       - .NET 6+
       - .NET Framework 4.6.2+
       ========================================================= -->
  <PropertyGroup Condition="
      '$(TargetFramework)' == 'net6.0'
      Or '$(TargetFramework)' == 'net7.0'">
    <BingTestingProfile>ModernV2Runner</BingTestingProfile>
    <BingMicrosoftNetTestSdkVersion>17.13.0</BingMicrosoftNetTestSdkVersion>
    <BingXunitRunnerVersion>2.8.2</BingXunitRunnerVersion>
    <BingCoverletVersion>6.0.4</BingCoverletVersion>
    <BingTestingCoverageSupported>true</BingTestingCoverageSupported>
    <BingTestingXunitV3Supported>false</BingTestingXunitV3Supported>
  </PropertyGroup>

  <!-- =========================================================================
       .NET Framework 4.7.2+
       xUnit v3 Supported
       ========================================================================= -->
  <PropertyGroup Condition="
      '$(TargetFramework)' == 'net472'
      Or '$(TargetFramework)' == 'net48'
      Or '$(TargetFramework)' == 'net481'">
    <BingTestingProfile>Modern</BingTestingProfile>
    <BingMicrosoftNetTestSdkVersion>18.9.0</BingMicrosoftNetTestSdkVersion>
    <BingXunitRunnerVersion>4.0.0</BingXunitRunnerVersion>
    <BingCoverletVersion>10.0.1</BingCoverletVersion>
    <BingTestingCoverageSupported>true</BingTestingCoverageSupported>
    <BingTestingXunitV3Supported>true</BingTestingXunitV3Supported>
  </PropertyGroup>

  <!-- =========================================================================
       .NET 8+
       xUnit v3 Supported

       当前显式覆盖 net8 ~ net11。
       后续新 TFM 建议在确认 Test SDK / Runner / Coverlet 兼容性后加入。
       ========================================================================= -->
  <PropertyGroup Condition="
      '$(TargetFramework)' == 'net8.0'
      Or '$(TargetFramework)' == 'net9.0'
      Or '$(TargetFramework)' == 'net10.0'
      Or '$(TargetFramework)' == 'net11.0'">
    <BingTestingProfile>Modern</BingTestingProfile>
    <BingMicrosoftNetTestSdkVersion>18.9.0</BingMicrosoftNetTestSdkVersion>
    <BingXunitRunnerVersion>4.0.0</BingXunitRunnerVersion>
    <BingCoverletVersion>10.0.1</BingCoverletVersion>
    <BingTestingCoverageSupported>true</BingTestingCoverageSupported>
    <BingTestingXunitV3Supported>true</BingTestingXunitV3Supported>
  </PropertyGroup>

  <!-- =========================================================================
       显式 Override
       =========================================================================
       推荐特殊项目使用 *Override 属性覆盖公共默认值。

       示例：
         <BingXunitV3VersionOverride>4.0.0</BingXunitV3VersionOverride>
         <BingXunitRunnerVersionOverride>4.0.0</BingXunitRunnerVersionOverride>
       ========================================================================= -->
  <PropertyGroup>

    <BingMicrosoftNetTestSdkVersion
      Condition="'$(BingMicrosoftNetTestSdkVersionOverride)' != ''">
      $(BingMicrosoftNetTestSdkVersionOverride)
    </BingMicrosoftNetTestSdkVersion>

    <BingXunitRunnerVersion
      Condition="'$(BingXunitRunnerVersionOverride)' != ''">
      $(BingXunitRunnerVersionOverride)
    </BingXunitRunnerVersion>

    <BingCoverletVersion
      Condition="'$(BingCoverletVersionOverride)' != ''">
      $(BingCoverletVersionOverride)
    </BingCoverletVersion>

    <BingShouldlyVersion
      Condition="'$(BingShouldlyVersionOverride)' != ''">
      $(BingShouldlyVersionOverride)
    </BingShouldlyVersion>

    <BingMoqVersion
      Condition="'$(BingMoqVersionOverride)' != ''">
      $(BingMoqVersionOverride)
    </BingMoqVersion>

    <BingXunitV2Version
      Condition="'$(BingXunitV2VersionOverride)' != ''">
      $(BingXunitV2VersionOverride)
    </BingXunitV2Version>

    <BingXunitV3Version
      Condition="'$(BingXunitV3VersionOverride)' != ''">
      $(BingXunitV3VersionOverride)
    </BingXunitV3Version>

  </PropertyGroup>


  <!-- =========================================================================
       Resolve xUnit Mode
       ========================================================================= -->
  <PropertyGroup>
    <!-- 默认 -->
    <BingTestingResolvedXunitMode>V2</BingTestingResolvedXunitMode>
    <!-- V2 -->
    <BingTestingResolvedXunitMode Condition="'$(BingTestingXunitMode)' == 'V2'">V2</BingTestingResolvedXunitMode>
    <!-- V3 -->
    <BingTestingResolvedXunitMode Condition="'$(BingTestingXunitMode)' == 'V3'">V3</BingTestingResolvedXunitMode>
    <!-- Auto -> V3 -->
    <BingTestingResolvedXunitMode
      Condition="
          '$(BingTestingXunitMode)' == 'Auto'
          And '$(BingTestingXunitV3Supported)' == 'true'">V3</BingTestingResolvedXunitMode>
    <!-- Auto -> V2 -->
    <BingTestingResolvedXunitMode
      Condition="
          '$(BingTestingXunitMode)' == 'Auto'
          And '$(BingTestingXunitV3Supported)' != 'true'">V2</BingTestingResolvedXunitMode>
  </PropertyGroup>

</Project>